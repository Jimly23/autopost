# Backend Target URL for Vite Proxy (pilih salah satu sesuai backend yang sedang dijalankan)
# Laravel + Gateway Proxy: http://127.0.0.1:8000
# Express Backend: http://127.0.0.1:3000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL untuk Axios API client (/api menggunakan reverse proxy Vite)
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_TITLE="Automation - Social Media Manager"
